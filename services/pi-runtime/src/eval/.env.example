# eval BYOK（自带模型渠道）配置示例 —— 复制为 .env 后填真实值。
# ⭐ 真实 key 只放这里（.env 已被 gitignore），绝不进代码 / 不进聊天。
#   cp .env.example .env   # 然后编辑 .env
#
# 用途：让 L1 行为回归跑批走你自己的模型渠道（DeepSeek 等 OpenAI 兼容端点），
#       从而绕开生产 AGNES 账号的 rpm 限流（429）。不设这些变量则回落 AGNES（既有行为）。

# 你的渠道 API key（必填；不填 ⇒ 回落 AGNES）
EVAL_BYOK_API_KEY=sk-your-deepseek-or-reseller-key

# OpenAI 兼容端点（必填，不含尾斜杠）
EVAL_BYOK_BASE_URL=https://api.deepseek.com/v1

# 渠道内的精确模型 id（必填）
EVAL_BYOK_MODEL=deepseek-v4-flash

# provider 标签（可选，默认 eval-byok；仅用于日志归因，不回显 key）
EVAL_BYOK_PROVIDER=eval-byok

# 是否为推理模型（可选；true/1/yes ⇒ reasoning:true）
EVAL_BYOK_REASONING=false
