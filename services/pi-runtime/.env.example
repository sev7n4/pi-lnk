# pi-runtime 环境变量总表（services/pi-runtime）
#
# ⚠️ 本文件是「说明文档」，pi-runtime 不自动加载 .env（无 dotenv）。
#   - 本地 dev：node --env-file=.env dist/index.js（或逐个 export）
#   - 生产 CVM：唯一生效通道 = .github/workflows/runtime-deploy.yml 的 helm --set-string 清单；
#     /opt/lnkpi/.env 只喂 docker-compose 的 Nest api 容器，写在这里的 pi-runtime 变量【不生效】。
#   - 数字/浮点型 env 在 helm 侧一律 --set-string（防 toYaml 科学计数法截断，2026-09-29 事故）。

# ── 服务 ─────────────────────────────────────────────
PORT=8100
# 会话数据根目录（默认 <cwd>/.pi-runtime-data）
# PI_RUNTIME_DATA_DIR=/data/pi-runtime
PI_RUNTIME_VERSION=0.0.28

# ── 会话保留（磁盘 LRU）──────────────────────────────
PI_RUNTIME_SESSION_TTL_MS=1800000        # 30min 无活动过期
PI_RUNTIME_SESSION_SWEEP_MS=300000       # 5min 扫描周期
PI_RUNTIME_SESSIONS_MAX_BYTES=3221225472 # 3 GiB
PI_RUNTIME_SESSIONS_MAX_COUNT=200

# ── LLM 通道（agnes 中转）────────────────────────────
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1
AGNES_MODEL_ID=agnes-2.5-pro

# agnes 费率（USD / 百万 token）—— vendor calculateCost 只认 model.cost，
# 不配置 = 四项全 0（cost 指标存在但恒 0）。按 Gemini 2.5 Flash 官方牌价：
#   input $0.30 / output $2.50 / 缓存读 $0.075（=input 的 25%）；
#   cacheWrite 记 0：Gemini 不按 token 计缓存写入费（显式缓存按存储时长计费，无法折算到请求）。
# ⚠️ agnes 中转实际结算价可能不同，此处为牌价近似，用于成本归因而非账单对账。
AGNES_COST_INPUT_PER_M=0.3
AGNES_COST_OUTPUT_PER_M=2.5
AGNES_COST_CACHE_READ_PER_M=0.075
AGNES_COST_CACHE_WRITE_PER_M=0

# ── 上下文压缩 ───────────────────────────────────────
PI_RUNTIME_COMPACTION_ENABLED=true
# 触发口径二选一（审计 P0-①，2026-10-01）：
#   1) TARGET_RATIO（推荐）：触发点 = 有效窗口 × (1−ratio)。0.7 = 用到 70% 即压缩。
#      有效窗口 = PI_RUNTIME_COMPACTION_CONTEXT_WINDOW ?? model.contextWindow。
#   2) RESERVE_TOKENS（旧口径）：触发点 = 有效窗口 − reserve。
#   ⚠️ 显式设置 RESERVE_TOKENS 时 ratio 失效（旧口径优先）——两者只配一个。
PI_RUNTIME_COMPACTION_TARGET_RATIO=0.7
# PI_RUNTIME_COMPACTION_RESERVE_TOKENS=16384   # 旧口径；生产回滚开关（见上）
PI_RUNTIME_COMPACTION_KEEP_RECENT_TOKENS=20000
# 覆盖分母窗口（agnes 实测 1M 声明值虚高；生产 128k）
PI_RUNTIME_COMPACTION_CONTEXT_WINDOW=128000

# ── 工具渐进加载（审计 P0-④）────────────────────────
# true = 23 个常驻工具进 schema，15 个延迟工具经 tool_search 搜索激活
# （vendor 原生 addedToolNames 机制，host 零运行态管理）。
# off = 逐字节回全量旧行为（kill switch）。新增工具必须登记 tools/tiering.ts 的
# ALWAYS_ON 名单，否则默认被延迟（模型可从索引块发现并 load）。
PI_RUNTIME_TOOL_TIERING=true

# ── 阻塞式确认（ask_user / propose_generation）───────
ASK_USER_BLOCKING=true
ASK_USER_TIMEOUT_MS=300000              # 5min（生产实证精确触发）

# ── 其他 ─────────────────────────────────────────────
# PI_RUNTIME_SKILLS_DIR=                 # 默认 <pkg>/skills
# PI_RUNTIME_SYSTEM_PROMPT=              # 覆盖默认系统提示词
# PI_RUNTIME_THINKING_LEVEL=             # 透传 agnes thinking 档位
# PI_RUNTIME_IMAGE_REFINE=
