{
  "name": "lnkpi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "超创平台 - AI 无限画布创作工作流平台",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @lnkpi/web dev",
    "dev:server": "pnpm --filter @lnkpi/server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:server": "pnpm --filter @lnkpi/server exec vitest run",
    "test:server:changed": "pnpm --filter @lnkpi/server exec vitest run --changed origin/master",
    "test:runtime": "pnpm --filter @pi-lnk/pi-runtime test",
    "verify-contract": "npx tsx scripts/verify-contract.ts",
    "verify-tool-contract": "npx tsx scripts/verify-tool-contract.ts",
    "verify-tool-tiering": "npx tsx scripts/verify-tool-tiering.ts",
    "verify-u-i2v-phase3": "npx tsx scripts/verify-u-i2v-phase3.ts",
    "verify-spec-figures": "npx tsx scripts/verify-spec-figures.ts",
    "verify-claims": "npx tsx scripts/verify-claims.ts",
    "verify-links": "npx tsx scripts/verify-links.ts",
    "prompt:lint": "npx tsx scripts/prompt-lint.ts",
    "memory:check": "npx tsx scripts/check-memory-size.ts"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
