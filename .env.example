# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lnkpi?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# BYOK encryption (32-byte random key, base64 — e.g. openssl rand -base64 32)
BYOK_ENCRYPTION_KEY_V1=""

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173,https://*.vercel.app"
API_PUBLIC_URL="http://localhost:3001"
# Production: use nginx public entry (e.g. :8888), not direct API port (:5100).

# Web (Vercel / 本地构建)
# 本地 dev 留空即可（走 Vite proxy /api）
# Vercel 生产推荐 /api（由 vercel.json rewrite 到 CVM）；勿在 HTTPS 页面直连 http://IP
# VITE_API_BASE_URL=/api

# Auth SMS（未接入短信前保持 fixed）
AUTH_SMS_MODE=fixed
AUTH_FIXED_CODE=123456

# AI Providers (optional — without key, RuleBasedAgent + placeholder images are used)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="dall-e-3"

# fal.ai — same Key as SAM / ESRGAN; also used for H3 Max / Turbo video (platform path).
# Optional FAL_BASE_URL overrides the default https://fal.run.
# BYOK: set channel apiKey + baseUrl https://fal.run (no separate secret).
FAL_KEY=""
# FAL_BASE_URL="https://fal.run"

# MiniMax Open Platform — official MiniMax-H3 video (P0 T2V/I2V/first-last).
# BYOK: channel apiKey + https://api.minimax.io (Bearer). Not the fal H3 Max Key.
MINIMAX_API_KEY=""
# MINIMAX_BASE_URL="https://api.minimax.io"

# Agent Runtime (Nest internal canvas tools + optional LangGraph runtime)
# Must match Runtime LNKPI_NEST_SERVICE_TOKEN
AGENT_RUNTIME_SERVICE_TOKEN="dev-token"
# When set and GET {url}/health is ok, Nest chat proxies to Runtime /v1/runs
AGENT_RUNTIME_URL="http://127.0.0.1:8000"

# pi-runtime (new agent runtime, services/pi-runtime — spec B2/B8)
# Migration期与老 agent-runtime(:8000) 共存；端口约定见 AGENTS.md
PI_RUNTIME_URL="http://127.0.0.1:8100"
# D-ζ' 双 runtime 开关（spec §10.3）：
#   off（默认）= 全走 LangGraph；shadow = LangGraph 照常 + pi 镜像流量（P0 验证）；
#   active = chat 流主切 pi-runtime（healthz 失败自动回落 LangGraph）
PI_RUNTIME_MODE="off"
# pi-runtime 的模型凭据（同 lnkpi 生产中转；缺省回退 OPENAI_API_KEY）
# AGNES_API_KEY=""
# AGNES_BASE_URL="https://apihub.agnes-ai.cn/v1"
# AGNES_MODEL_ID="agnes-2.5-pro"

# —— 上下文工程（PR #95，完整清单与语义见 services/pi-runtime/.env.example）——
# ⚠️ 生产唯一生效通道 = runtime-deploy.yml 的 helm --set-string；本文件仅供本地 dev。
# 压缩触发点 = 窗口比例口径（0.7 = 有效窗口用到 70% 即压缩）。显式设
# PI_RUNTIME_COMPACTION_RESERVE_TOKENS 时本项失效（旧口径优先，二者只配一个）。
PI_RUNTIME_COMPACTION_TARGET_RATIO=0.7
# 工具渐进加载（23 常驻 + 15 延迟，load_tools 按需激活）；off = 逐字节回全量旧行为
PI_RUNTIME_TOOL_TIERING=true
# agnes（Gemini 2.5 Flash）费率，USD/百万 token。不配置 = cost 恒 0（现状行为）。
AGNES_COST_INPUT_PER_M=0.3
AGNES_COST_OUTPUT_PER_M=2.5
AGNES_COST_CACHE_READ_PER_M=0.075
AGNES_COST_CACHE_WRITE_PER_M=0

