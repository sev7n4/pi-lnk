# 服务间鉴权：pi-runtime → Nest `/agent/internal/*` 画布工具（头 `x-lnkpi-service-token`）。
# ⚠️ 老 LangGraph runtime 已退役，但此 token **仍在用**——删掉会让 pi 的画布读写工具全部 401。
# 变量名 AGENT_RUNTIME_* 是历史命名；新名 LNKPI_INTERNAL_SERVICE_TOKEN 优先，旧名兜底。
LNKPI_INTERNAL_SERVICE_TOKEN="dev-token"
AGENT_RUNTIME_SERVICE_TOKEN="dev-token"

# pi-runtime（K3s，NodePort 30100）。默认 active；设 off 为维护态（chat 与心跳均报不可用）。
PI_RUNTIME_MODE=active
PI_RUNTIME_URL="http://127.0.0.1:30100"

# Object storage — Wave A A3 media persist
# When OBJECT_STORAGE_ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY are all set → COS/S3.
# When unset → LocalFilesystemStorageAdapter writes to uploads/ (CVM disk / docker volume).
# OBJECT_STORAGE_DRIVER=none → force 503 (disable persist-remote rehost).
# OBJECT_STORAGE_DRIVER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=ap-guangzhou
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Optional override for local uploads root (default: <cwd>/uploads)
# UPLOADS_ROOT=

# ── 生成确认的审批分级（授权自动生成，规格 2026-11-22-generation-auto-approve-gate-design）──
# GENERATION_APPROVAL_MODE：系统总闸三态（缺省 tiered = 兼容现状）
#   tiered      = tier 白名单 + 用户级账号偏好（autoApproveGenerations）决定是否免确认
#   full_manual = 强制全人工（覆盖用户授权，部署级止血开关）
#   auto_all    = 全介质免确认（成本放大，仅运营场景）
# GENERATION_AUTO_APPROVE：tier 白名单，逗号分隔介质（缺省 text；置空 = 白名单空 ⇒ text 也走人工）
# GENERATION_APPROVAL_MODE=tiered
# GENERATION_AUTO_APPROVE=text
