generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String             @id @default(cuid())
  phone      String             @unique
  nickname   String
  avatar     String?
  points     Int                @default(1000)
  pointsFrozen Int              @default(0) // P2 token 计费：回合预扣冻结额
  lastDailyClaimAt DateTime?    // P0 止血：每日签到幂等，记录上次领取时间（实际 UTC ms）
  membership String             @default("free")
  createdAt  DateTime           @default(now())
  inviteCode       String?  @unique
  invitedByUserId  String?
  invitedBy        User?    @relation("UserInvites", fields: [invitedByUserId], references: [id])
  invitees         User[]   @relation("UserInvites")
  inviteRedemptionsAsInvitee InviteRedemption? @relation("RedemptionInvitee")
  inviteRedemptionsAsInviter InviteRedemption[] @relation("RedemptionInviter")
  sessions   Session[]
  works      Work[]
  stories    Story[]
  generations GenerationRecord[]
  pointTransactions PointTransaction[]
  holds             PointHold[]
  orders            Order[]
  subscriptions     Subscription[]
  providerChannels ProviderChannel[]
  aiPreferences    UserAiPreferences?
  webdavConfig     UserWebdavConfig?
  assets           UserAsset[]
  workflowRecipes  UserWorkflowRecipe[]
  // 2026-10-21 P2：创作者关注关系 + 置顶作品（加法式变更，不动既有字段）
  //
  // ⚠️ pinnedWorkIds 用 **JSON 字符串** 而非 `String[]`：SQLite 连接器不支持
  // 标量列表（Prisma 会报 P1012 "can't be a list"）。序列化约定：
  // 写入 `JSON.stringify(ids)`，读出 `JSON.parse` 后在服务层校验形状，
  // 解析失败一律回落空数组（存量脏值不该让创作者页整页崩）。
  pinnedWorkIds    String             @default("[]")
  followers        Follow[]           @relation("FollowFollower")
  following        Follow[]           @relation("FollowFollowing")
}

/// 关注关系（2026-10-21 P2）——「A 关注 B」的一条边。
///
/// 设计要点：
///   - `@@unique([followerId, followingId])` 让「重复关注」在数据库层被挡住，
///     服务端捕获 P2002 后转成幂等成功（用户连点两次不该报错）。
///   - 复合索引按 followingId 建：创作者页要查「谁关注了我」，那是反向查询。
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// 订阅（连续包月）——「一个用户同时只持有一个套餐」的权威周期事实。
///
/// User.membership 只是「当前档位」的快查字段；周期、到期、是否已取消续期一律以本表为准：
///   - periodEnd 之前档位有效；到期后惰性失效（读时降级，见 membership.service）。
///   - cancelAtPeriodEnd=true = 已取消自动续期，**到期前仍可继续使用**（≠ 立即退订）。
///   - 续期成功 = 同档订单再次支付成功，periodEnd 顺延一个月（而非覆盖）。
/// 历史订单在 Order 表；一个用户只保留一条「当前订阅」，避免多活订阅并存导致权益歧义。
model Subscription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String // experience | standard | premium | flagship（与 membership PLANS 对齐）
  status            String    @default("active") // active=生效中 | canceled=已取消续期（到期前仍可用） | expired=已到期或已退订
  periodStart       DateTime // 本周期起点（首次支付时间）
  periodEnd         DateTime // 本周期截止（续期顺延；到期即失效）
  cancelAtPeriodEnd Boolean   @default(false) // 取消自动续期标记（周期扣款签约是否已解约见 agreementNo）
  agreementNo       String? // 支付宝周期扣款签约号；未签约为 NULL（手动续期模式）
  canceledAt        DateTime? // 取消续期操作时间
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([periodEnd])
}

model InviteRedemption {
  id                         String   @id @default(cuid())
  inviteeId                  String   @unique
  invitee                    User     @relation("RedemptionInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviterId                  String
  inviter                    User     @relation("RedemptionInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteCode                 String
  inviteePoints              Int
  inviterPoints              Int
  inviterRewardSkippedReason String?
  createdAt                  DateTime @default(now())

  @@index([inviterId, createdAt])
}

// 用户全局资产库：跨画布可用，用户在节点上主动保存或面板上传入库
model UserAsset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String   @default("image") // image | video | audio
  url          String
  label        String   @default("")
  sourceNodeId String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@unique([userId, url])
  @@index([userId, createdAt])
}

model UserWorkflowRecipe {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId        String
  version         String
  title           String
  parentId        String?
  parentVersion   String?
  body            String
  sourceSessionId String?
  sourceHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
}

model ProviderChannel {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  apiFormat       String
  baseUrl         String
  encryptedApiKey String?
  iv              String?
  authTag         String?
  keyVersion      Int      @default(1)
  models          String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model UserAiPreferences {
  userId                 String  @id
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectableImageModels  String  @default("[]")
  selectableVideoModels  String  @default("[]")
  selectableTextModels   String  @default("[]")
  selectableAudioModels  String  @default("[]")
  disabledModels         String  @default("[]")
  defaultImageModel      String  @default("")
  defaultVideoModel      String  @default("")
  defaultTextModel       String  @default("")
  defaultAudioModel      String  @default("")
  canvasImageCount       Int     @default(3)
  defaultImageAspect     String  @default("16:9")
  defaultImageResolution String  @default("1K")
  defaultVideoAspect     String  @default("16:9")
  defaultVideoDuration   Int     @default(5)
  defaultVideoResolution String  @default("720p")
  defaultVideoCrop       String  @default("none")
  audioVoice             String  @default("female-shaonv")
  audioFormat            String  @default("mp3")
  audioSpeed             Float   @default(1)
  audioInstructions      String?
  systemPrompt           String?
}

model UserWebdavConfig {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url               String    @default("")
  directory         String    @default("")
  username          String    @default("")
  encryptedPassword String?
  iv                String?
  authTag           String?
  keyVersion        Int       @default(1)
  connectionMode    String    @default("proxy")
  lastSyncedAt      DateTime?
}

model PointTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String
  kind         String   @default("consume")
  category     String   @default("other")
  status       String?
  model        String?
  generationId String?
  balanceAfter Int?
  ruleVersion String?
  grayReleaseId String?
  /// 多池记账（spec 2026-10-13-billing-points-system-design §多池）：
  /// 该笔积分变动归属的池。purchased=支付购买（可设有效期）、granted=赠送/签到（默认）、
  /// subscription=订阅赠送。存量行迁移默认 'granted'（历史无池概念，且当前无 purchased/subscription 流水）。
  /// 结算路径仍以 User.points 为单一权威余额；本字段服务审计/按池汇总，不改动计费扣减链路。
  pool         String   @default("granted")
  /// 有效期截止（UTC ms）；仅部分 grant 有值（如购买积分包）。到期后不计入可用余额，
  /// 但保留在账本供对账。到期自动扣减 User.points 属后续（当前无 expiresAt 流水，暂无到期项）。
  expiresAt    DateTime?
  /// 关联支付订单 id（purchased 池溯源用；支付闭环落地后由 Order 填充）。无支付时为 NULL。
  orderId      String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, category, createdAt])
  @@index([userId, pool])
}

// 支付订单（风险 #2：真实支付闭环）。一次性购买语义：升级 pro/studio 套餐 / 购买积分包。
// 金额单位「分」（Int），杜绝浮点误差；支付宝 total_amount 由分→元字符串转换在 adapter 内完成。
// status 机：PENDING → PAID（回调验签通过，CAS 唯一入口）/ CLOSED（超时未付，定时或手动关单）。
// ⚠️ 严禁任何「未校验 Payment 即发分」路径：入账唯一入口是 Payment 回调（验签 + CAS）。
model Order {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String // subscription: experience | standard | premium | flagship · topup: 'topup' · points-<pkg>（与 membership PLANS 对齐）
  kind      String    @default("subscription") // subscription=套餐订阅 | topup=积分充值
  points    Int? // topup：发放总积分（基础+赠送）；subscription 为 NULL
  amount    Int // 单位：分
  status    String    @default("PENDING") // PENDING | PAID | CLOSED | REFUNDED
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@index([userId, createdAt])
  @@index([status])
}

// 支付记录（幂等锚点：orderId @unique —— 同一订单只允许一条支付记录、只结算一次）。
// raw 存支付宝异步通知原始报文（JSON），供对账/纠纷取证。
model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel        String // alipay（后续可扩展 wechat/stripe）
  channelTradeNo String? // 支付宝交易号 trade_no
  status         String   @default("PENDING") // PENDING | SUCCESS | FAILED
  raw            String? // 回调原始报文 JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
}

model GenerationRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  prompt    String
  model     String?
  url       String?
  status    String   @default("completed")
  metadata  String?
  sessionId String?
  nodeId    String?
  createdAt DateTime @default(now())
  /**
   * 记录最后变更时刻（2026-10-21 补列，修既存生产 bug）。
   *
   * ⭐ 为什么必须有这一列（不能改用 `createdAt`）：
   * 本表是**可变**的（`studio.service.ts` 有 40+ 处 update：status 流转、
   * url 回填、metadata 写入）⇒ `createdAt` ≠ 最后变更时刻。
   * 而「回合外终态通报」的 reaper 按「**最近 10 分钟内进入终态**」扫
   * （`late-generation-notify.ts` 的 `where.updatedAt.gte` + `orderBy.updatedAt.asc`，
   * 注释原话：*"终态后 10min 内必被扫到"*）⇒ 语义**必须**是 updatedAt。
   *
   * ⛔ 用 `createdAt` 的后果：一个 3 小时前创建、1 分钟前完成的生成记录
   * 落在 10min 回看窗**之外** ⇒ 永远扫不到 ⇒ 用户收不到「生成完成」通知
   * ⇒ 破坏 reaper 的核心保证。
   *
   * prisma `@updatedAt` ⇒ create/update 时由**客户端自动**写入 ⇒ 业务代码零改动。
   */
  updatedAt DateTime @updatedAt

  @@index([userId, sessionId, createdAt])
  /**
   * reaper 的扫描索引：按「最后变更」取最近窗口的终态记录。
   * ⚠️ 与上面的 `[userId, sessionId, createdAt]` **不是**替代关系 ——
   * 后者服务用户维度的历史列表，前者服务状态流转的时间窗扫描。
   */
  @@index([updatedAt])
}

model Story {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  synopsis     String   @default("")
  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id])
  status       String   @default("draft")
  episodeCount Int      @default(1)
  coverUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id                   String         @id @default(cuid())
  title                String         @default("未命名画布")
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  canvasData           String?
  compositionPreview   String?
  compositionPending   String?
  stagedActions        String?
  stagedAt             DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  works         Work[]
  shots         Shot[]
  agentMessages AgentMessage[]
  agentThreads  AgentThread[]
  stories       Story[]
}

model Shot {
  id        String     @id @default(cuid())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String     @default("未命名分镜")
  prompt    String     @default("")
  order     Int        @default(0)
  status    String     @default("draft")
  positionX Float      @default(0)
  positionY Float      @default(0)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Material {
  id        String   @id @default(cuid())
  shotId    String
  shot      Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  type      String   @default("image")
  url       String?
  thumbnail String?
  prompt    String?
  status    String   @default("idle")
  metadata  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AgentThread {
  id        String   @id // threadId，格式 sessionId:suffix
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String   @default("新对话")
  /**
   * 回合连续性状态（JSON 字符串，2026-10-21 回合连续性修正）。
   *
   * ⭐ 这是「第四份状态」的**权威副本**（另三份：Nest AgentMessage = 展示层 SSOT、
   * pi transcript = 模型上下文 SSOT、Session.canvasData = 画布 SSOT）。
   * 「上一轮任务进行到哪」不属于上面任何一份 ⇒ 必须独立持久。
   *
   * ⭐ 为什么挂在**线程**上而不是画布（Session）：一个画布可以有多个对话线程，
   * 每个线程有各自的上下文与进度 ⇒ 状态是线程级的。
   *
   * ⚠️ 可空：绝大多数线程没有未完成状态（NULL = 无）。
   * 读写约定：写 `JSON.stringify(state)`，读出后 `parseTurnState` 校验形状，
   * 解析失败回落 undefined（**宁可不注入，也不投坏数据**）。
   */
  turnState String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AgentMessage[]

  @@index([sessionId, updatedAt(sort: Desc)])
}

model AgentMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  threadId      String
  thread        AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role          String
  content       String
  toolCalls     String?
  attachments   String?
  /** JSON: LinkedCanvasOutput[] — 本轮 assistant 产出的可定位节点 */
  linkedOutputs String?
  /** JSON: AgentMessageMetadata */
  metadata      String?
  /**
   * 回合身份（上游 pi-runtime 的 operationId，随 `run_start` 事件下发）。
   *
   * 2026-10-17（回合身份与单一写者）：与 `threadId` 组成唯一键，把「同一次 run
   * 只落一条助手消息」从**各端默契**升级为**数据库不变式**。此前靠默契的结果是
   * 生产实证同一次 run 落 4 条正文完全相同的助手消息（订阅切片各记一本账）。
   *
   * 可空是刻意的：pi-runtime 未透传身份时（滚动升级窗口）与全部存量行都是 NULL，
   * 而 SQLite 下 NULL 互不冲突 ⇒ **存量零回填、迁移纯 additive、可原样回滚**。
   */
  runId         String?
  /**
   * 用户消息的 pi 侧身份（vendor transcript entryId）。
   *
   * 2026-10-21（steer 落库 + 统一 user 消息身份）：此前本表**没有任何 user 消息的身份键**
   * （`runId` 只服务 assistant 的 operationId，user 消息恒为 NULL）⇒
   *   - 插话（steer/followUp）走队列 API、服务端从不建行 ⇒ **刷新后历史里这条消息直接消失**；
   *   - 刷新后恢复的历史消息没有 fork 切点 ⇒「③ 重跑」只能降级兜底。
   *
   * 来源与**可得时机**：vendor `QueueResult` 在**入队那一刻**就带 `{entryId}`
   * （`services/pi-runtime/src/session-manager.ts:2517/2583` ——
   *  `return { queued: true, entryId: res.value.entryId }`；#507 为「撤回」把它接出��，
   * 此前被丢弃）。正常发送的 entryId 则随 `pi_message_end` 事件下发给前端。
   * ⇒ 两条路径都能在**发言被持久化的同一时刻**拿到 entryId，落库零竞态、不依赖客户端在线。
   *
   * 可空 + 唯一是刻意的：assistant 行与全部存量行都是 NULL，
   * 而 SQLite 下 NULL 互不冲突 ⇒ **存量零回填、迁移纯 additive、可原样回滚**。
   */
  entryId       String?
  /**
   * 会话内单调序号（D6：投影面的续传游标）。
   *
   * 2026-10-22（多端同会话一致性 · Task 7）：把「这个会话里第几条」落成数据库事实。
   * 此前分页/续传只能拿 `createdAt` 当游标 ⇒ 同毫秒写入的消息在页边界重复或漏掉，
   * 且历史与实时增量各记一本账、到达顺序一变就错位（M1 的根因）。
   *
   * ⚠️ 当前是**临时可空态**：迁移 20261022043000 只加列不回填（见该文件的五步走说明）。
   * 回填由后续迁移 `@@unique([threadId, seq])` 收口；在那之前**没有任何读路径依赖它**，
   * 故可空不影响现有行为。回填的排序口径见 `computeSeqs`（createdAt, id 兜底 ⇒ 可重放）。
   */
  seq           Int?
  /**
   * 乐观插入幂等键（spec §5.5）：客户端本地生成，一路贯通到唯一索引，
   * 使「同一条发言重试 N 次仍至多一行」。服务端确认后才是权威 `id`。
   * 可空：存量行与服务端发起的行（assistant）都没有它。
   */
  clientId      String?
  /**
   * 排队中标记（D5）：插话/尾随在 pi 侧队列里**尚未被消费**时为 true，
   * 被消费后转 false。不转终态的话用户会永远看到「排队中」（Review Focus #3）。
   */
  queued        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  /// 回合唯一性不变式：同一 thread 里同一 run 至多一条消息。
  /// 落库走 upsert（先到先得），后来者命中即 no-op —— 即便上游 409 判定漏了、
  /// 或出现第三个写者（generation-recovery 的 drain），也无法再写进重复行。
  @@unique([threadId, runId])
  /// user 消息身份键：同一条发言至多一行。消息重放、多次重试都命中即 no-op。
  @@unique([entryId])
  @@index([threadId, createdAt])
  @@index([sessionId, threadId, createdAt])
}

/// S1-1 定时探活对账（spec: docs/superpowers/specs/2026-10-09-mph-s11-liveness-reconciliation-design.md）：
/// 每次对某上游 /v1/models 的实测落一帧（只读探测，任何情况下不发生成请求）。
/// ghosts/missing 为 JSON 数组字符串；error 非空表示本次探测失败（非模型级结论）。
/// 供 S1-2 端点 `GET /api/admin/upstream-probe/latest` 与运维 SQL 检查。
model UpstreamProbeRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  upstream   String
  httpStatus Int?
  modelCount Int?
  /// JSON 数组：目录有而上游无的 modelKey（幽灵候选，灰显与否由 Ruling A 双条件判定）
  ghosts     String?
  /// JSON 数组：上游有而目录无的原始 id（上架机会）
  missing    String?
  /// 探测失败原因（HTTP 非 200 / fetch 异常）；非空时 ghosts/missing 无意义
  error      String?
  /// 探活触发来源：'startup'|'periodic'|'manual'（B3 加列，旧行为 NULL，无回填）
  reason     String?
  /// 盲区声明跳过标记（model-ops Task 3）：'probeMode=none' = 该上游无 /models 在售清单，
  /// 本轮有意跳过拉取与 diff（非失败）；旧行为 NULL，无回填
  skipped    String?

  @@index([upstream, ranAt])
}

/// S2-1 模型目录数据化（spec: docs/superpowers/specs/2026-10-09-mph-s21-catalog-as-data-design.md）：
/// DB 是模型目录的**唯一真源**；`STUDIO_MODEL_CATALOG` 代码常量降级为播种种子
/// （bootstrap 时 insert-if-absent——按 modelKey 存在即跳过，绝不覆盖，人工/后台改动存活）。
/// 字段与 `StudioModelEntry` 逐字同构；params/voices/defaults 为 JSON 字符串（仓内惯例）。
/// 下架 = 软删（deletedAt，同 S0-1 语义）；软删行在播种存在性检查中仍算「已存在」，不复活。
model ModelCatalogEntry {
  id              String   @id @default(cuid())
  modelKey        String   @unique
  displayName     String
  gatewayModelId  String
  modality        String
  providerBinding String
  /// 仅 modality === 'audio' 时存在；缺省视作 voice
  audioKind       String?
  /// JSON: StudioVoiceOption[]（{ id, label }[]）
  voices          String?
  /// JSON: Record<string, ParamDisposition>
  params          String
  /// JSON: Record<string, string | number>
  defaults        String?
  /// 每模态默认标记（model-ops Task 1）：部分唯一索引保证每模态至多一个活默认；
  /// 写路径只有 admin model-defaults 端点与本 migration 回填（单写原则）
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([modality, deletedAt])
}

/// S2-1b 目录/路由版本号表：按 id 分域的单行版本计数（运营写端点每次写操作原子 +1，
/// 单调递增、last-write-win）。已知两行：id='catalog'（S2-1b 目录版本，ensurePlatformChannel
/// 对齐前比对）；id='routes'（S2-2b 路由版本，运营改路由 bump，探活器下个周期生效）。
model ModelCatalogVersion {
  id        String   @id @default("catalog")
  version   Int
  updatedAt DateTime @updatedAt
}

/// S2-2a 上游路由表（spec: docs/superpowers/specs/2026-10-09-mph-s22-routing-table-design.md §3.1）：
/// 「哪个模型走哪个上游」的数据真源。matchType ∈ prefix|exact|regex|default，
/// default 行（pattern 为空）= 未命中兜底；enabled=false 即下线该行（无软删列）。
/// upstream ∈ agnes_hub|apimart|stepfun|minimax|fal。种子从 legacy resolver 链逐条翻译
/// （shared UPSTREAM_ROUTE_SEEDS，insert-if-absent 只插不改，存在即跳过）。
/// fallbackApiKeyEnvName：命中行的密钥回落 env 名——apimart 行记录 'OPENAI_API_KEY'
/// （legacy resolveApimartPlatformCredentials 的 apimartApiKey || openaiApiKey 回落语义）。
model UpstreamRoute {
  id                    String   @id @default(cuid())
  matchType             String
  pattern               String?
  capability            String
  upstream              String
  priority              Int      @default(0)
  enabled               Boolean  @default(true)
  fallbackApiKeyEnvName String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled, priority])
}

/// S2-1b admin 写操作审计行（who/when/before/after）。who 为 'admin'
/// —— 共享密钥鉴权（AdminTokenGuard）无更细身份，密钥本身绝不落库。
/// before/after 为写操作前后行快照 JSON（create 时 before 为 null）。
model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  resource  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

/// Idempotency records for POST /agent/chat/conversation — prevent duplicate requests
/// from network retries. 5 min TTL, lazy-cleaned on each lookup.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  sessionId      String
  threadId       String
  status         String   @default("processing") // processing | completed | error
  resultSummary  String?  // assistant text summary (≤500 chars) after completion
  createdAt      DateTime @default(now())
  expiresAt      DateTime // createdAt + 5 min

  @@index([expiresAt])
}

model Work {
  id           String   @id @default(cuid())
  title        String
  coverUrl     String
  playbackUrl  String?
  playbackKind String?
  type         String   @default("canvas")
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id])
  likes        Int      @default(0)
  views        Int      @default(0)
  category     String?
  createdAt    DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ThreadLock {
  threadId       String   @id
  leaseHolder    String
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leaseExpiresAt])
}

// 生成进度记录：外置 transient 数据，减少 checkpoint 体积（W15）
model GenProgress {
  id        String   @id @default(cuid())
  threadId  String
  sessionId String
  lines     String   // JSON 数组
  summary   String?  // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
}

// Context 快照：brief/plan/manifest 摘要外置，减少 LLM 上下文扫描（W18）
model ContextSnapshot {
  id            String   @id @default(cuid())
  threadId      String
  sessionId     String
  stage         String   // plan | split
  brief         String?
  planSummary   String?
  manifestJson  String?  // JSON 数组摘要
  messageCount  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([threadId, stage, createdAt])
}

/// P1 memory（spec 2026-09-29）：agent 记忆。
/// 作用域隔离（2026-10-03）：默认 canvas，只有显式 scope='user' 才跨画布。
/// 背景：生产事故——同画布会话读到另一画布的《小熊和小爸爸》项目记忆并被当成图片内容输出。
model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  /// 'canvas'（本画布，需 sessionId）| 'user'（跨画布）。迁移默认 'user' 保旧行为可秒级回滚。
  scope     String   @default("user")
  /// scope='canvas' 时的画布会话 id（Session.id，非 pi 会话键）
  sessionId String?
  /// 来源：agent_auto / user_explicit / promoted（审计用，不做行为分支）
  source    String   @default("agent_auto")
  content   String
  createdAt DateTime @default(now())

  @@index([userId, scope, sessionId])
  @@map("agent_memories")
}

// ── C5 Automations（spec docs/superpowers/specs/2026-10-11-automations-design.md）──────
// AutomationJob：配置层（handler 代码级注册，运维配置级）。id 用固定语义键
// （'job-upstream-probe'），种子 create-if-missing（D5），admin 不发 id。
model AutomationJob {
  id                String   @id
  name              String
  description       String?
  handlerKey        String
  enabled           Boolean  @default(true)
  scheduleType      String   @default("interval") // P0 仅 interval；cron 属 P2
  intervalMinutes   Int      @default(5)
  params            String? // JSON
  concurrencyPolicy String   @default("forbid") // forbid | replace | allow（P0 replace 视同 forbid，D6）
  runOnStartup      Boolean  @default(false) // D1：启动后延迟派发一次 reason='startup'
  failureThreshold  Int      @default(3) // P1 告警消费
  failureWebhook    String? // P1 告警消费
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  runs              AutomationRun[]
}

// AutomationRun：运行史（G2）。reason: scheduled|manual|startup；status: running|success|failure|skipped
model AutomationRun {
  id         String        @id @default(cuid())
  jobId      String
  job        AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason     String
  status     String        @default("running")
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  output     String? // JSON（reapOnce 返回的收尾条数等）
  error      String?

  @@index([jobId, startedAt])
}

// ── 定价体系（P0 等价迁移 · spec 2026-10-13-pricing-baseline-config-design.md §4）──
// P0 口径：PriceListEntry.credits 是权威售价（显式值，seed 自 legacy 常量）；
// CostRate/MarginPolicy 为溯源与 P1 重定价地基，P0 不从它们推导售价。

model PriceListVersion {
  id          String           @id @default(cuid())
  version     String           @unique
  status      String           @default("draft") // draft | active | archived
  note        String?
  createdAt   DateTime         @default(now())
  publishedAt DateTime?
  entries     PriceListEntry[]
  grayReleases PricingGrayRelease[]
}

model PriceListEntry {
  id         String           @id @default(cuid())
  versionId  String
  version    PriceListVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  capability String
  matchKey   String
  credits    Int
  basis      String           @default("legacy-equivalent")
  costRateId String?
  costRate   CostRate?        @relation(fields: [costRateId], references: [id])
  @@unique([versionId, matchKey])
  @@index([versionId, capability])
}

model CostRate {
  id        String          @id @default(cuid())
  channel   String
  modelKey  String
  spec      String
  unit      String
  costYuan  Float
  source    String          @default("official_list")
  note      String?
  createdAt DateTime        @default(now())
  entries   PriceListEntry[]
  @@unique([channel, modelKey, spec])
}

model MarginPolicy {
  id                  String   @id @default(cuid())
  phase               String   @unique
  anchorCents         Int      @default(1)
  marginBp            Int      @default(11000)
  capabilityOverrides String? // JSON，如 {"video":11000}；P1 重定价消费
  createdAt           DateTime @default(now())
}

// ── 白名单灰度发布（P1-a · 2026-10-14-p1a-pricing-publishing-gray-release）──
model PricingGrayRelease {
  id        String   @id @default(cuid())
  versionId String
  version   PriceListVersion @relation(fields: [versionId], references: [id])
  status    String   @default("active") // active | promoted | rolled_back | expired
  startsAt  DateTime
  endsAt    DateTime
  createdBy String   @default("admin")
  note      String?
  createdAt DateTime @default(now())
  whitelist PricingGrayWhitelist[]
  @@index([status, endsAt])
}

model PricingGrayWhitelist {
  id        String             @id @default(cuid())
  releaseId String
  release   PricingGrayRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId    String
  phone     String
  note      String?
  @@unique([releaseId, userId])
  @@index([userId])
}

// ── P2 token 精确计费（2026-10-15-p2-token-precise-billing）──
// PointHold：回合预扣冻结单。回合发起先冻结积分（User.pointsFrozen），结算时
// 按实际用量 settle（差额自然留在余额），error/超时由 releaseExpiredHolds 全退防泄漏。
// status: held（冻结中）| settled（已结算）| released（已释放）
model PointHold {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  amount         Int
  status         String    @default("held") // held | settled | released
  settledCredits Int?
  reason         String?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}
