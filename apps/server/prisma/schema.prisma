generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String             @id @default(cuid())
  phone      String             @unique
  nickname   String
  avatar     String?
  points     Int                @default(1000)
  membership String             @default("free")
  createdAt  DateTime           @default(now())
  inviteCode       String?  @unique
  invitedByUserId  String?
  invitedBy        User?    @relation("UserInvites", fields: [invitedByUserId], references: [id])
  invitees         User[]   @relation("UserInvites")
  inviteRedemptionsAsInvitee InviteRedemption? @relation("RedemptionInvitee")
  inviteRedemptionsAsInviter InviteRedemption[] @relation("RedemptionInviter")
  sessions   Session[]
  works      Work[]
  stories    Story[]
  generations GenerationRecord[]
  pointTransactions PointTransaction[]
  providerChannels ProviderChannel[]
  aiPreferences    UserAiPreferences?
  webdavConfig     UserWebdavConfig?
  assets           UserAsset[]
  workflowRecipes  UserWorkflowRecipe[]
}

model InviteRedemption {
  id                         String   @id @default(cuid())
  inviteeId                  String   @unique
  invitee                    User     @relation("RedemptionInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviterId                  String
  inviter                    User     @relation("RedemptionInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteCode                 String
  inviteePoints              Int
  inviterPoints              Int
  inviterRewardSkippedReason String?
  createdAt                  DateTime @default(now())

  @@index([inviterId, createdAt])
}

// 用户全局资产库：跨画布可用，用户在节点上主动保存或面板上传入库
model UserAsset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String   @default("image") // image | video | audio
  url          String
  label        String   @default("")
  sourceNodeId String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@unique([userId, url])
  @@index([userId, createdAt])
}

model UserWorkflowRecipe {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId        String
  version         String
  title           String
  parentId        String?
  parentVersion   String?
  body            String
  sourceSessionId String?
  sourceHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
}

model ProviderChannel {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  apiFormat       String
  baseUrl         String
  encryptedApiKey String?
  iv              String?
  authTag         String?
  keyVersion      Int      @default(1)
  models          String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model UserAiPreferences {
  userId                 String  @id
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectableImageModels  String  @default("[]")
  selectableVideoModels  String  @default("[]")
  selectableTextModels   String  @default("[]")
  selectableAudioModels  String  @default("[]")
  disabledModels         String  @default("[]")
  defaultImageModel      String  @default("")
  defaultVideoModel      String  @default("")
  defaultTextModel       String  @default("")
  defaultAudioModel      String  @default("")
  canvasImageCount       Int     @default(3)
  defaultImageAspect     String  @default("16:9")
  defaultImageResolution String  @default("1K")
  defaultVideoAspect     String  @default("16:9")
  defaultVideoDuration   Int     @default(5)
  defaultVideoResolution String  @default("720p")
  defaultVideoCrop       String  @default("none")
  audioVoice             String  @default("female-shaonv")
  audioFormat            String  @default("mp3")
  audioSpeed             Float   @default(1)
  audioInstructions      String?
  systemPrompt           String?
}

model UserWebdavConfig {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url               String    @default("")
  directory         String    @default("")
  username          String    @default("")
  encryptedPassword String?
  iv                String?
  authTag           String?
  keyVersion        Int       @default(1)
  connectionMode    String    @default("proxy")
  lastSyncedAt      DateTime?
}

model PointTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String
  kind         String   @default("consume")
  category     String   @default("other")
  status       String?
  model        String?
  generationId String?
  balanceAfter Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, category, createdAt])
}

model GenerationRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  prompt    String
  model     String?
  url       String?
  status    String   @default("completed")
  metadata  String?
  sessionId String?
  nodeId    String?
  createdAt DateTime @default(now())

  @@index([userId, sessionId, createdAt])
}

model Story {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  synopsis     String   @default("")
  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id])
  status       String   @default("draft")
  episodeCount Int      @default(1)
  coverUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id                   String         @id @default(cuid())
  title                String         @default("未命名画布")
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  canvasData           String?
  compositionPreview   String?
  compositionPending   String?
  stagedActions        String?
  stagedAt             DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  works         Work[]
  shots         Shot[]
  agentMessages AgentMessage[]
  agentThreads  AgentThread[]
  stories       Story[]
}

model Shot {
  id        String     @id @default(cuid())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String     @default("未命名分镜")
  prompt    String     @default("")
  order     Int        @default(0)
  status    String     @default("draft")
  positionX Float      @default(0)
  positionY Float      @default(0)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Material {
  id        String   @id @default(cuid())
  shotId    String
  shot      Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  type      String   @default("image")
  url       String?
  thumbnail String?
  prompt    String?
  status    String   @default("idle")
  metadata  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AgentThread {
  id        String   @id // threadId，格式 sessionId:suffix
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AgentMessage[]

  @@index([sessionId, updatedAt(sort: Desc)])
}

model AgentMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  threadId      String
  thread        AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role          String
  content       String
  toolCalls     String?
  attachments   String?
  /** JSON: LinkedCanvasOutput[] — 本轮 assistant 产出的可定位节点 */
  linkedOutputs String?
  /** JSON: AgentMessageMetadata */
  metadata      String?
  createdAt     DateTime    @default(now())

  @@index([threadId, createdAt])
  @@index([sessionId, threadId, createdAt])
}

/// S1-1 定时探活对账（spec: docs/superpowers/specs/2026-10-09-mph-s11-liveness-reconciliation-design.md）：
/// 每次对某上游 /v1/models 的实测落一帧（只读探测，任何情况下不发生成请求）。
/// ghosts/missing 为 JSON 数组字符串；error 非空表示本次探测失败（非模型级结论）。
/// 供 S1-2 端点 `GET /api/admin/upstream-probe/latest` 与运维 SQL 检查。
model UpstreamProbeRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  upstream   String
  httpStatus Int?
  modelCount Int?
  /// JSON 数组：目录有而上游无的 modelKey（幽灵候选，灰显与否由 Ruling A 双条件判定）
  ghosts     String?
  /// JSON 数组：上游有而目录无的原始 id（上架机会）
  missing    String?
  /// 探测失败原因（HTTP 非 200 / fetch 异常）；非空时 ghosts/missing 无意义
  error      String?

  @@index([upstream, ranAt])
}

/// S2-1 模型目录数据化（spec: docs/superpowers/specs/2026-10-09-mph-s21-catalog-as-data-design.md）：
/// DB 是模型目录的**唯一真源**；`STUDIO_MODEL_CATALOG` 代码常量降级为播种种子
/// （bootstrap 时 insert-if-absent——按 modelKey 存在即跳过，绝不覆盖，人工/后台改动存活）。
/// 字段与 `StudioModelEntry` 逐字同构；params/voices/defaults 为 JSON 字符串（仓内惯例）。
/// 下架 = 软删（deletedAt，同 S0-1 语义）；软删行在播种存在性检查中仍算「已存在」，不复活。
model ModelCatalogEntry {
  id              String   @id @default(cuid())
  modelKey        String   @unique
  displayName     String
  gatewayModelId  String
  modality        String
  providerBinding String
  /// 仅 modality === 'audio' 时存在；缺省视作 voice
  audioKind       String?
  /// JSON: StudioVoiceOption[]（{ id, label }[]）
  voices          String?
  /// JSON: Record<string, ParamDisposition>
  params          String
  /// JSON: Record<string, string | number>
  defaults        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([modality, deletedAt])
}

/// S2-1b 目录/路由版本号表：按 id 分域的单行版本计数（运营写端点每次写操作原子 +1，
/// 单调递增、last-write-win）。已知两行：id='catalog'（S2-1b 目录版本，ensurePlatformChannel
/// 对齐前比对）；id='routes'（S2-2b 路由版本，运营改路由 bump，探活器下个周期生效）。
model ModelCatalogVersion {
  id        String   @id @default("catalog")
  version   Int
  updatedAt DateTime @updatedAt
}

/// S2-2a 上游路由表（spec: docs/superpowers/specs/2026-10-09-mph-s22-routing-table-design.md §3.1）：
/// 「哪个模型走哪个上游」的数据真源。matchType ∈ prefix|exact|regex|default，
/// default 行（pattern 为空）= 未命中兜底；enabled=false 即下线该行（无软删列）。
/// upstream ∈ agnes_hub|apimart|stepfun|minimax|fal。种子从 legacy resolver 链逐条翻译
/// （shared UPSTREAM_ROUTE_SEEDS，insert-if-absent 只插不改，存在即跳过）。
/// fallbackApiKeyEnvName：命中行的密钥回落 env 名——apimart 行记录 'OPENAI_API_KEY'
/// （legacy resolveApimartPlatformCredentials 的 apimartApiKey || openaiApiKey 回落语义）。
model UpstreamRoute {
  id                    String   @id @default(cuid())
  matchType             String
  pattern               String?
  capability            String
  upstream              String
  priority              Int      @default(0)
  enabled               Boolean  @default(true)
  fallbackApiKeyEnvName String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled, priority])
}

/// S2-1b admin 写操作审计行（who/when/before/after）。who 为 'admin'
/// —— 共享密钥鉴权（AdminTokenGuard）无更细身份，密钥本身绝不落库。
/// before/after 为写操作前后行快照 JSON（create 时 before 为 null）。
model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  resource  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

/// Idempotency records for POST /agent/chat/conversation — prevent duplicate requests
/// from network retries. 5 min TTL, lazy-cleaned on each lookup.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  sessionId      String
  threadId       String
  status         String   @default("processing") // processing | completed | error
  resultSummary  String?  // assistant text summary (≤500 chars) after completion
  createdAt      DateTime @default(now())
  expiresAt      DateTime // createdAt + 5 min

  @@index([expiresAt])
}

model Work {
  id           String   @id @default(cuid())
  title        String
  coverUrl     String
  playbackUrl  String?
  playbackKind String?
  type         String   @default("canvas")
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id])
  likes        Int      @default(0)
  views        Int      @default(0)
  category     String?
  createdAt    DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ThreadLock {
  threadId       String   @id
  leaseHolder    String
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leaseExpiresAt])
}

// 生成进度记录：外置 transient 数据，减少 checkpoint 体积（W15）
model GenProgress {
  id        String   @id @default(cuid())
  threadId  String
  sessionId String
  lines     String   // JSON 数组
  summary   String?  // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
}

// Context 快照：brief/plan/manifest 摘要外置，减少 LLM 上下文扫描（W18）
model ContextSnapshot {
  id            String   @id @default(cuid())
  threadId      String
  sessionId     String
  stage         String   // plan | split
  brief         String?
  planSummary   String?
  manifestJson  String?  // JSON 数组摘要
  messageCount  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([threadId, stage, createdAt])
}

/// P1 memory（spec 2026-09-29）：agent 记忆。
/// 作用域隔离（2026-10-03）：默认 canvas，只有显式 scope='user' 才跨画布。
/// 背景：生产事故——同画布会话读到另一画布的《小熊和小爸爸》项目记忆并被当成图片内容输出。
model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  /// 'canvas'（本画布，需 sessionId）| 'user'（跨画布）。迁移默认 'user' 保旧行为可秒级回滚。
  scope     String   @default("user")
  /// scope='canvas' 时的画布会话 id（Session.id，非 pi 会话键）
  sessionId String?
  /// 来源：agent_auto / user_explicit / promoted（审计用，不做行为分支）
  source    String   @default("agent_auto")
  content   String
  createdAt DateTime @default(now())

  @@index([userId, scope, sessionId])
  @@map("agent_memories")
}
