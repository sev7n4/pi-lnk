# VoiceStudio 部署 env 模板（deploy/voicestudio/.env 的种子）
# 复制为 .env 后填值；⛔ .env 不进仓（同机生产 secrets 一律走 .env / K8s secret）
#
# 三方同钥：本 key 必须同时出现在三处
#   ① 本文件 OMNIVOICE_API_KEY（VS 容器自己校验入站请求）
#   ② Nest 侧 OMNIVOICE_API_KEY（lnkpi-api 容器 env，P1 TTS 直连）
#   ③ pi-runtime 侧 OMNIVOICE_API_KEY（K3s pod env，P2 MCP 桥 Bearer）
# 生成：openssl rand -hex 32

OMNIVOICE_API_KEY=<openssl rand -hex 32 生成后填入>

# ── Nest（lnkpi-api 容器）两项（P1，配好即自动启用 voicestudio-local 模型行）──
# OMNIVOICE_BASE_URL=http://172.17.0.1:3900/v1
# OMNIVOICE_API_KEY=<同上>

# ── pi-runtime（K3s pod）两项（P2 MCP 桥）──
# OMNIVOICE_MCP_URL=http://172.17.0.1:3900/mcp/
# OMNIVOICE_API_KEY=<同上>

# ── 可选调优（compose 已内置合理默认，无需写入 .env）──
# VS_MEM_LIMIT=4g            # compose mem_limit 变量；16G 扩容后可改 8g
# OMNIVOICE_CPU_POOL          # 默认 min(8, cpu_count)，4 核自动取 4
