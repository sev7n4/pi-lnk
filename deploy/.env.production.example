# 复制到 /opt/lnkpi/.env（勿提交 Git）
# cp deploy/.env.production.example .env

# --- 公网访问（按实际 IP / 域名修改）---
# Vercel 前端会通过此 API 地址访问后端
API_PUBLIC_URL=http://119.29.173.89:8888
CORS_ORIGIN=http://localhost:5173,https://*.vercel.app

# --- API 核心（必填，请替换占位符）---
PORT=3001
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRES_IN=7d
# BYOK 服务端加密主密钥（32 字节随机，base64 — 例：openssl rand -base64 32）
BYOK_ENCRYPTION_KEY_V1=
DATABASE_URL=file:/app/apps/server/data/lnkpi.db

# --- 登录验证码（未接入短信前保持 fixed）---
AUTH_SMS_MODE=fixed
AUTH_FIXED_CODE=123456

# --- AI Providers（可选；无 key 时使用 RuleBasedAgent + 占位图）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VIDEO_MODEL=agnes-video-v2.0
# 元素编辑对象命名用的识图文本模型（可选；缺省回落 OPENAI_CHAT_MODEL，需在识图白名单内）
# LNKPI_VISION_NAMING_MODEL=agnes-2.0-flash
# Agnes 视频轮询根路径（非 /v1）
AGNES_API_ROOT=https://apihub.agnes-ai.com

# Agnes 示例（勿提交真实 Key）：
# OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# OPENAI_CHAT_MODEL=agnes-2.0-flash
# OPENAI_IMAGE_MODEL=agnes-image-2.1-flash
# OPENAI_VIDEO_MODEL=agnes-video-v2.0

# APIMart（image2 / seedream-5.0-pro 专用；文本/视频仍走 OPENAI_* → Agnes）
# 海外出站需 HTTPS_PROXY + NODE_USE_ENV_PROXY=1（见下方注释）
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
# HTTPS_PROXY=http://172.17.0.1:17891
# HTTP_PROXY=http://172.17.0.1:17891
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,lnkpi-api,postgres,redis

# --- StepFun（平台级语音供应商：TTS / 综合音频生成 / 音乐生成）---
# ⚠️ 值由 .github/workflows/deploy.yml 的 "Inject platform provider keys into CVM .env"
#    步骤从 GitHub Secret `STEPFUN_API_KEY` 幂等 upsert 写入，勿在 CVM 上单独手工维护
#    （换机/首次部署会静默丢失）。仅未接入流水线的新环境才需手工填这一项。
# ⚠️ 平台渠道凭证只从 env 读取（provider-resolver.service.ts 读 process.env），写 DB 无效。
# 名称沿用 deploy/stepfun-tts-live-probe.mjs 的既有约定。
STEPFUN_API_KEY=
# STEPFUN_BASE_URL=https://api.stepfun.com/v1

# --- 媒体持久化（Wave A A3）---
# 四项均配置 → 腾讯云 COS / S3；留空 → 写入本机 uploads 卷（docker volume lnkpi-uploads）
# OBJECT_STORAGE_DRIVER=none → 关闭 persist-remote（503）
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_REGION=ap-guangzhou
# OBJECT_STORAGE_PUBLIC_BASE_URL=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- pi-runtime（K3s，NodePort 30100；详见 docs/ops/RUNBOOK-pi-runtime-deploy.md）---
# 默认 active；设 off = 维护态（chat 与心跳均报不可用，无第二条链路可回落）
PI_RUNTIME_MODE=active
PI_RUNTIME_URL=http://172.20.0.1:30100

# --- 服务互信（老 LangGraph runtime 已退役，此 token 仍被 pi-runtime 使用）---
# pi-runtime → Nest `/agent/internal/*` 画布工具：头 x-lnkpi-service-token。
# ⚠️ 不是可删项：留空会让 pi 的画布读写工具全部 401。
# 新名优先、旧名兜底（旧名是历史命名，暂与线上 .env 保持一致）。
LNKPI_INTERNAL_SERVICE_TOKEN=
AGENT_RUNTIME_SERVICE_TOKEN=
# pi-runtime → Nest 的 base（必须带 /api 前缀）
LNKPI_NEST_BASE_URL=http://10.1.0.12:5100/api
LNKPI_NEST_SERVICE_TOKEN=
LNKPI_IMAGE_GEN_TIMEOUT_SEC=180
# Product visual scheme v2 — prose SSOT + macro/shot（UAT 必开；改动后重启 pi-runtime）
LNKPI_PRODUCT_VISUAL_SCHEME_V2=true
# UX-PV-10: merge shot + topo gate (hard stops ≤3)
LNKPI_PV_MERGED_SHOT_TOPO_GATE=true

# W23 OTLP tracing（⚠️ 写入脚本 enable-agent-runtime.sh 已随老 runtime 退役删除；本段当前无生产者）
# 复用同机 pintuotuo Tempo：http://pintuotuo-tempo:4318/v1/traces
# 设 ENABLE_OBSERVABILITY=false 可跳过（仅本地调试）
LNKPI_OTEL_EXPORTER_OTLP_ENDPOINT=http://pintuotuo-tempo:4318/v1/traces
LNKPI_LANGSMITH_OTEL_ENABLED=false
LNKPI_OTEL_SERVICE_NAME=lnkpi-agent-runtime

# --- Matting（自托管 rembg 抠图容器；详见 deploy/docker/matting/）---
# 默认走容器内网地址（compose 已注入同值），无需改动；
# 仅当把 matting 部署在其他主机/端口时才覆盖此项
# MATTING_SERVICE_URL=http://lnkpi-matting:8000

# --- 图片生成收尾机制（generation reaper）---
# 超过该分钟数仍停在 generating 的图片记录会被周期巡检标记 failed 并自动退款
# （默认 30，可不设）。启动后 15s 会先扫一轮，回收进程重启丢掉的在飞任务。
# LNKPI_GENERATION_REAP_MINUTES=30
