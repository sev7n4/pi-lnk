# lnkpi API（NestJS + Prisma SQLite）
FROM node:22-bookworm-slim AS build
# CVM 跨境访问 deb.debian.org 极慢；仅在 deploy 脚本传 USE_TENCENT_APT_MIRROR=1 时换 http 腾讯源
ARG USE_TENCENT_APT_MIRROR=0
RUN if [ "$USE_TENCENT_APT_MIRROR" = "1" ]; then \
      for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e 's|https://deb.debian.org|http://mirrors.cloud.tencent.com|g' \
          -e 's|http://deb.debian.org|http://mirrors.cloud.tencent.com|g' \
          -e 's|https://security.debian.org|http://mirrors.cloud.tencent.com/debian-security|g' \
          -e 's|http://security.debian.org|http://mirrors.cloud.tencent.com/debian-security|g' \
          "$f"; \
      done; \
    fi
# build 阶段仅需 openssl（Prisma）；视频时间线 worker 需编译 editly 原生依赖（canvas/gl）
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
    build-essential python-is-python3 \
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev libgl1-mesa-dev libxi-dev \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# pnpm.patchedDependencies（0.99.2 addedToolNames 恢复补丁）：install 阶段按哈希读取 patch 文件，缺失即 ENOENT
COPY patches ./patches
COPY packages ./packages
COPY apps/server ./apps/server
COPY deploy/docker ./deploy/docker
# W1a：提示词注册中心。rules/*.md 被 .dockerignore 的 *.md 挡过，靠白名单放行。
COPY prompt-registry ./prompt-registry

# workspace 包以 CommonJS 编译，便于 Nest 运行时 require
RUN node -e "\
  const fs=require('fs');\
  for (const p of ['packages/shared/tsconfig.json','packages/agent/tsconfig.json']) {\
    const j=JSON.parse(fs.readFileSync(p,'utf8'));\
    j.compilerOptions.module='CommonJS';\
    j.compilerOptions.moduleResolution='node';\
    fs.writeFileSync(p, JSON.stringify(j,null,2));\
  }"

# 安装除 apps/web 外全部 workspace（保留 agent/shared 的 devDeps 供 tsc build）
# ⚠️ registry 必须显式指向国内镜像：CVM 构建容器到 registry.npmjs.org(Cloudflare) 的连接会
#   挂起（实测 pnpm 卡死 40min+，进程 CPU 时间停在 23s 不再增长，ESTABLISHED 但收发队列为 0），
#   导致 docker build 永不结束、deploy run 被后续进组的 run 挤掉。走 npmmirror 稳定秒级。
RUN pnpm install --frozen-lockfile --filter '!@lnkpi/web' --registry=https://registry.npmmirror.com
RUN pnpm --filter @lnkpi/shared build
RUN pnpm --filter @lnkpi/agent build
RUN node deploy/docker/patch-workspace-packages.cjs
WORKDIR /app/apps/server
RUN pnpm exec prisma generate
RUN pnpm run build
WORKDIR /app

# 视频时间线渲染内核：editly 固定 0.14.2，经 npm 隔离安装到 /opt/editly（不进 pnpm workspace 图，
# 避免 canvas@2 与 jsdom 的 canvas@^3 peer 冲突污染解析面、避免 CI 无 cairo 头文件被 optional 失败拖累）。
# 运行时经 NODE_PATH 解析 require('editly')；构建期缺失即失败（test -d 硬校验），不留静默坏镜像。
RUN mkdir -p /opt/editly && cd /opt/editly \
  && npm init -y >/dev/null \
  && npm install --no-audit --no-fund --loglevel=error editly@0.14.2 --registry=https://registry.npmmirror.com \
  && test -d /opt/editly/node_modules/editly

FROM node:22-bookworm-slim AS runner
ARG USE_TENCENT_APT_MIRROR=0
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV DATABASE_URL=file:/app/apps/server/data/lnkpi.db

RUN if [ "$USE_TENCENT_APT_MIRROR" = "1" ]; then \
      for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e 's|https://deb.debian.org|http://mirrors.cloud.tencent.com|g' \
          -e 's|http://deb.debian.org|http://mirrors.cloud.tencent.com|g' \
          -e 's|https://security.debian.org|http://mirrors.cloud.tencent.com/debian-security|g' \
          -e 's|http://security.debian.org|http://mirrors.cloud.tencent.com/debian-security|g' \
          "$f"; \
      done; \
    fi
# 视频时间线 worker 的 entrypoint 用 xvfb-run，xvfb-run 依赖 xauth（缺失会报
# "xvfb-run: error: xauth command not found" 直接退出）——两个必须同时装。
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg \
    xvfb xauth fontconfig fonts-dejavu-core \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 libgl1 libxi6 \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /app/apps/server/data /app/apps/server/uploads

# 视频时间线：editly 从隔离目录解析；渲染开关默认关闭（CVM 扩容前禁用，规格 §6.4）
ENV NODE_PATH=/opt/editly/node_modules
ENV VIDEO_TIMELINE_RENDER_ENABLED=false
COPY --from=build /opt/editly /opt/editly

COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/packages /app/packages
COPY --from=build /app/apps/server/dist ./apps/server/dist
# W1a：Registry 必须在 runner 阶段落地，否则 /app/prompt-registry 不存在 → degraded 兜底。
COPY --from=build /app/prompt-registry /app/prompt-registry
COPY --from=build /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=build /app/apps/server/prisma ./apps/server/prisma
COPY --from=build /app/apps/server/assets ./apps/server/assets
COPY --from=build /app/apps/server/package.json ./apps/server/
RUN rm -rf /app/packages/*/src /app/apps/server/src 2>/dev/null || true
COPY --from=build /app/deploy/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

WORKDIR /app/apps/server
EXPOSE 3001
VOLUME ["/app/apps/server/data", "/app/apps/server/uploads"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/docker-entrypoint.sh"]
